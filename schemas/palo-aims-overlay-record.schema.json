{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paloframework.org/schemas/palo-aims-overlay-record.schema.json",
  "title": "PALO ISO IEC 42001 AIMS Overlay Record",
  "type": "object",
  "required": ["format", "schemaVersion", "recordId", "organization", "scope", "context", "leadership", "planning", "support", "operation", "performanceEvaluation", "improvement", "authorityBoundary"],
  "properties": {
    "format": { "const": "palo-aims-overlay-record" }, "schemaVersion": { "const": "1.0.0" }, "recordId": { "type": "string" }, "organization": { "type": "string" },
    "scope": { "$ref": "#/$defs/section" }, "context": { "$ref": "#/$defs/section" }, "leadership": { "$ref": "#/$defs/section" }, "planning": { "$ref": "#/$defs/section" }, "support": { "$ref": "#/$defs/section" }, "operation": { "$ref": "#/$defs/section" }, "performanceEvaluation": { "$ref": "#/$defs/section" }, "improvement": { "$ref": "#/$defs/section" },
    "authorityBoundary": { "type": "string", "minLength": 40 }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["owner", "requirements", "evidenceRefs", "status", "reviewedAt", "reviewedBy", "findings"],
      "properties": {
        "owner": { "type": "string" }, "requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "status": { "enum": ["implemented", "partial", "gap", "not-applicable"] }, "reviewedAt": { "type": "string", "format": "date-time" }, "reviewedBy": { "type": "string" }, "findings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
