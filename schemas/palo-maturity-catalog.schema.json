{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paloframework.org/schemas/palo-maturity-catalog.schema.json",
  "title": "PALO AI maturity question catalog 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "title",
    "status",
    "publishedAt",
    "methodology",
    "levels",
    "evidenceTypes",
    "domains",
    "questions",
    "sources",
    "comparison"
  ],
  "properties": {
    "format": {
      "const": "palo-maturity-catalog"
    },
    "version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date"
    },
    "methodology": {
      "type": "string",
      "minLength": 1
    },
    "levels": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "label",
          "description"
        ],
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 5
    },
    "evidenceTypes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "cap"
            ],
            "properties": {
              "id": {
                "const": "none"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "cap": {
                "const": null
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "cap"
            ],
            "properties": {
              "id": {
                "const": "declared"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "cap": {
                "const": null
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "cap"
            ],
            "properties": {
              "id": {
                "const": "documented"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "cap": {
                "const": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "cap"
            ],
            "properties": {
              "id": {
                "const": "tested"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "cap": {
                "const": 2
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "cap"
            ],
            "properties": {
              "id": {
                "const": "monitored"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "cap": {
                "const": 3
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "cap"
            ],
            "properties": {
              "id": {
                "const": "independent"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "cap": {
                "const": 4
              }
            }
          }
        ]
      },
      "maxItems": 6
    },
    "domains": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "lens",
          "description"
        ],
        "properties": {
          "id": {
            "enum": [
              "deployment",
              "institutional",
              "authority",
              "behaviour",
              "evidence"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "lens": {
            "enum": [
              "deployment",
              "governance"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 5
    },
    "questions": {
      "type": "array",
      "minItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "title",
          "prompt",
          "evidence",
          "action",
          "gate",
          "controlIds",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(D[1-6]|[IABE][1-4])$"
          },
          "domain": {
            "enum": [
              "deployment",
              "institutional",
              "authority",
              "behaviour",
              "evidence"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "enum": [
              "frame",
              "classify",
              "assess",
              "control",
              "measure",
              "prove"
            ]
          },
          "controlIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "critical": {
            "type": "boolean"
          }
        }
      },
      "maxItems": 22
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkedAt",
          "publisher",
          "role",
          "sourceId",
          "sourceType",
          "title",
          "url"
        ],
        "properties": {
          "sourceType": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "checkedAt": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "comparison": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "established",
          "newPerspective"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "established": {
            "type": "string",
            "minLength": 1
          },
          "newPerspective": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
