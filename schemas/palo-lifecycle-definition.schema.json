{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paloframework.org/schemas/palo-lifecycle-definition.schema.json",
  "title": "PALO Lifecycle Definition",
  "type": "object",
  "required": ["format", "schemaVersion", "lifecycleId", "definitionVersion", "label", "status", "releasedAt", "frameworkRef", "phases", "gateDefinitions", "provenance"],
  "properties": {
    "format": { "const": "palo-lifecycle-definition" },
    "schemaVersion": { "const": "1.0.0" },
    "lifecycleId": { "type": "string", "format": "uri" },
    "definitionVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "label": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "in-review", "approved-for-release", "deprecated", "superseded"] },
    "releasedAt": { "type": "string", "format": "date" },
    "frameworkRef": { "type": "string", "format": "uri" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phaseDefinitionId", "semanticId", "definitionVersion", "ordinal", "label", "purpose", "gateDefinitionRef"],
        "properties": {
          "phaseDefinitionId": { "type": "string", "pattern": "^phase-[a-z0-9-]+$" },
          "semanticId": { "type": "string", "format": "uri" },
          "definitionVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "ordinal": { "type": "integer", "minimum": 1 },
          "label": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "gateDefinitionRef": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "gateDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gateDefinitionId", "gateId", "definitionVersion", "label", "purpose", "entryCriteria", "decisionOptions", "requiredControlIds", "indicatorIds", "sourceIds", "templateIds"],
        "properties": {
          "gateDefinitionId": { "type": "string", "format": "uri" },
          "gateId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "definitionVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "label": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "entryCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "decisionOptions": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": ["proceed", "proceed-with-conditions", "hold", "redesign", "stop"] } },
          "requiredControlIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "indicatorIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "templateIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generatedFrom", "authorityBoundary"],
      "properties": {
        "generatedFrom": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "authorityBoundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
