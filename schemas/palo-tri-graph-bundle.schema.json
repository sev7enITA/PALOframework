{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paloframework.org/schemas/palo-tri-graph-bundle.schema.json",
  "title": "PALO Tri-Graph reference rehearsal bundle",
  "type": "object",
  "properties": {
    "format": {
      "const": "palo-tri-graph-bundle"
    },
    "version": {
      "const": "0.1.0"
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "tenantId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "predicate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "object": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "authorityClass": {
                "type": "string",
                "enum": [
                  "curated",
                  "untrusted-external"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "supported",
                  "contested",
                  "unknown",
                  "revoked"
                ]
              },
              "validFrom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "format": "date-time"
              },
              "validUntil": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "format": "date-time"
              },
              "recordedAt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "tenantId",
              "subject",
              "purpose",
              "source",
              "predicate",
              "object",
              "authorityClass",
              "confidence",
              "status",
              "validFrom",
              "validUntil",
              "recordedAt"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "version",
        "assertions",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "procedure": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "operation": {
                "type": "string",
                "enum": [
                  "read",
                  "update",
                  "reconcile"
                ]
              },
              "requiredAssertions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
                },
                "maxItems": 1000,
                "uniqueItems": true
              },
              "guards": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "authority",
                    "freshness",
                    "closure",
                    "resource",
                    "budget",
                    "approval",
                    "replay",
                    "effect"
                  ]
                },
                "maxItems": 1000,
                "uniqueItems": true
              },
              "requiresApproval": {
                "type": "boolean"
              },
              "accountableRole": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              }
            },
            "required": [
              "id",
              "from",
              "to",
              "operation",
              "requiredAssertions",
              "guards",
              "requiresApproval",
              "accountableRole"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "version",
        "states",
        "transitions"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "format": "date-time"
        },
        "bindings": {
          "type": "object",
          "properties": {
            "knowledge": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "procedure": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "vocabulary": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "knowledge",
            "procedure",
            "vocabulary"
          ],
          "additionalProperties": false
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "actor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              },
              "policyVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
              }
            },
            "required": [
              "id",
              "reason",
              "actor",
              "policyVersion"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "resourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "authorityEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policyEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pendingEffect": {
          "type": "string",
          "enum": [
            "none",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "tenantId",
        "caseId",
        "subject",
        "purpose",
        "createdAt",
        "validUntil",
        "bindings",
        "selected",
        "excluded",
        "resourceVersion",
        "authorityEpoch",
        "policyEpoch",
        "pendingEffect"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "operation": {
          "type": "string",
          "enum": [
            "read",
            "update",
            "reconcile"
          ]
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,199}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "tenantId",
        "caseId",
        "subject",
        "purpose",
        "from",
        "to",
        "operation",
        "resource",
        "cost",
        "nonce",
        "sequence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "knowledge",
    "procedure",
    "context",
    "request"
  ],
  "additionalProperties": false
}
