@prefix palo: <https://paloframework.org/semantic/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

palo:case-example a palo:GovernanceCase, palo:SemanticEntity ; palo:stableId "case-example" .
palo:gate-assess-v3 a palo:GateDefinition, palo:CanonicalDefinition, palo:SemanticEntity ; palo:stableId "gate-assess" ; palo:definitionVersion "3.0.0" .
palo:phase-assess-v3 a palo:PhaseDefinition, palo:CanonicalDefinition, palo:SemanticEntity ; palo:stableId "phase-assess" ; palo:definitionVersion "3.0.0" .
palo:lifecycle-core-v3 a palo:LifecycleDefinition, palo:CanonicalDefinition, palo:SemanticEntity ; palo:stableId "lifecycle-core" ; palo:definitionVersion "3.0.0" ; palo:hasPhaseDefinition palo:phase-assess-v3 ; palo:hasGateDefinition palo:gate-assess-v3 .
palo:gate-instance-example a palo:GateInstance, palo:SemanticEntity ; palo:stableId "gate-instance-example" ; palo:caseId "case-example" ; palo:instantiatesGate palo:gate-assess-v3 ; palo:gateInstanceCase palo:case-example .
palo:actor-example a palo:SemanticEntity ; palo:stableId "actor-example" .
palo:artifact-example a palo:EvidenceArtifact, palo:SemanticEntity ; palo:stableId "artifact-example" ; palo:caseId "case-example" ; palo:contentDigest "sha256:1111111111111111111111111111111111111111111111111111111111111111" .
palo:claim-example a palo:EvidenceClaim, palo:ImmutableRecord, palo:SemanticEntity ; palo:stableId "claim-example" ; palo:usesArtifact palo:artifact-example ; palo:supportsTarget palo:gate-instance-example ; palo:claimScope palo:case-example ; palo:claimStatement "The scoped gate has the required test evidence." ; palo:integrityReference "sha256:1111111111111111111111111111111111111111111111111111111111111111" ; palo:recordedAt "2026-08-12T09:35:00Z"^^xsd:dateTime ; palo:recordDigest "sha256:2222222222222222222222222222222222222222222222222222222222222222" ; palo:appendOnly true .
palo:evaluation-example a palo:EvidenceEvaluation, palo:ImmutableRecord, palo:SemanticEntity ; palo:stableId "evaluation-example" ; palo:evaluatesClaim palo:claim-example ; palo:evaluationOutcome "partial" ; palo:recordedAt "2026-08-12T09:50:00Z"^^xsd:dateTime ; palo:recordDigest "sha256:3333333333333333333333333333333333333333333333333333333333333333" ; palo:appendOnly true .
palo:decision-example a palo:GateDecisionRecord, palo:DecisionRecord, palo:ImmutableRecord, palo:SemanticEntity ; palo:stableId "decision-example" ; palo:decisionForGate palo:gate-instance-example ; palo:decisionActor palo:actor-example ; palo:authorityBasis "Assigned governance decision right." ; palo:rationale "Proceed with the recorded condition." ; palo:inputSnapshotHash "sha256:4444444444444444444444444444444444444444444444444444444444444444" ; palo:recordedAt "2026-08-12T10:00:00Z"^^xsd:dateTime ; palo:recordDigest "sha256:5555555555555555555555555555555555555555555555555555555555555555" ; palo:appendOnly true .
