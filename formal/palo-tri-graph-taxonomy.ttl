@prefix tg: <https://paloframework.org/semantic/tri-graph/> .
@prefix palo: <https://paloframework.org/semantic/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tg:Taxonomy a skos:ConceptScheme ; skos:prefLabel "PALO Tri-Graph Governance"@en .
tg:knowledge a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:prefLabel "Knowledge Graph"@en ; skos:definition "Conoscenza attribuita e versionata"@it .
tg:context a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:prefLabel "Context Graph"@en ; skos:definition "Contesto completo e valido per la decisione"@it .
tg:procedure a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:prefLabel "Procedural Graph"@en ; skos:definition "Transizioni consentite e verificabili"@it .
tg:assurance a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:prefLabel "Assurance trasversale"@en ; skos:definition "Prove, responsabilità e cambiamento controllato; non un quarto pillar"@it .
tg:term-KnowledgeGraph a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:knowledge ; skos:prefLabel "Knowledge graph"@en, "Grafo di conoscenza"@it ; skos:definition "Asserzioni curate, fonti e dipendenze con identità e versione; la presenza di un fatto non concede autorità."@it ; skos:relatedMatch tg:KnowledgeGraph .
tg:term-KnowledgeAssertion a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:knowledge ; skos:prefLabel "Knowledge assertion"@en, "Asserzione verificabile"@it ; skos:definition "Enunciato con fonte, stato epistemico, validità e momento di registrazione. Può essere contestato o revocato."@it ; skos:relatedMatch tg:KnowledgeAssertion .
tg:term-SourceRecord a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:knowledge ; skos:prefLabel "Source record"@en, "Fonte"@it ; skos:definition "Riferimento alla provenienza e alla versione acquisita; attendibilità e autorità restano distinte."@it ; skos:relatedMatch tg:SourceRecord .
tg:term-PolicyBinding a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:knowledge ; skos:prefLabel "Policy binding"@en, "Vincolo di policy"@it ; skos:definition "Collega una regola alla versione applicabile e alla decisione umana che ne ha stabilito lo scopo."@it ; skos:relatedMatch tg:PolicyBinding .
tg:term-VocabularyRelease a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:knowledge ; skos:prefLabel "Vocabulary release"@en, "Versione del vocabolario"@it ; skos:definition "Versione di ontologia, tassonomia e dizionario usata per interpretare una decisione."@it ; skos:relatedMatch tg:VocabularyRelease .
tg:term-ContextSnapshot a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:context ; skos:prefLabel "Decision context snapshot"@en, "Snapshot decisionale"@it ; skos:definition "Vista delimitata per tenant, caso, scopo e istante, legata ai digest di conoscenza, procedura e vocabolario."@it ; skos:relatedMatch tg:ContextSnapshot .
tg:term-ContextRequirement a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:context ; skos:prefLabel "Context requirement"@en, "Requisito di contesto"@it ; skos:definition "Dipendenza obbligatoria determinata dalla procedura curata; non selezionabile dal solo modello."@it ; skos:relatedMatch tg:ContextRequirement .
tg:term-ExclusionRecord a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:context ; skos:prefLabel "Exclusion record"@en, "Esclusione motivata"@it ; skos:definition "Registra un elemento escluso e il motivo; non permette di eliminare un controllo obbligatorio."@it ; skos:relatedMatch tg:ExclusionRecord .
tg:term-AuthorityObservation a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:context ; skos:prefLabel "Authority observation"@en, "Osservazione di autorità"@it ; skos:definition "Stato osservato di mandato, scopo, scadenza e revoche; in produzione deve provenire dal verificatore fidato."@it ; skos:relatedMatch tg:AuthorityObservation .
tg:term-ResourceObservation a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:context ; skos:prefLabel "Resource observation"@en, "Versione della risorsa"@it ; skos:definition "Versione corrente della risorsa da confrontare prima di produrre effetti."@it ; skos:relatedMatch tg:ResourceObservation .
tg:term-ProcedureGraph a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:procedure ; skos:prefLabel "Procedural graph"@en, "Grafo procedurale"@it ; skos:definition "Stati e transizioni versionati con guardie, requisiti e responsabilità; nessuna deviazione può ampliare il mandato."@it ; skos:relatedMatch tg:ProcedureGraph .
tg:term-ProcedureState a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:procedure ; skos:prefLabel "Procedure state"@en, "Stato procedurale"@it ; skos:definition "Posizione esplicita nel ciclo di una decisione, distinta dallo stato dell'effetto reale."@it ; skos:relatedMatch tg:ProcedureState .
tg:term-GuardedTransition a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:procedure ; skos:prefLabel "Guarded transition"@en, "Transizione condizionata"@it ; skos:definition "Arco da uno stato al successivo con guardie deterministiche e prove obbligatorie."@it ; skos:relatedMatch tg:GuardedTransition .
tg:term-ActionProposal a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:procedure ; skos:prefLabel "Action proposal"@en, "Proposta di azione"@it ; skos:definition "Richiesta con scopo e risorsa che deve ancora ottenere l'ammissione dell'esecutore."@it ; skos:relatedMatch tg:ActionProposal .
tg:term-DecisionReceipt a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:assurance ; skos:prefLabel "Decision receipt"@en, "Ricevuta decisionale"@it ; skos:definition "Esito riproducibile con regole, input e motivazioni; non è un token di esecuzione."@it ; skos:relatedMatch tg:DecisionReceipt .
tg:term-EffectObservation a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:assurance ; skos:prefLabel "Effect observation"@en, "Osservazione dell'effetto"@it ; skos:definition "Evidenza proveniente dalla risorsa autorevole dopo il tentativo; il timeout può lasciare l'effetto incerto."@it ; skos:relatedMatch tg:EffectObservation .
tg:term-ChangeProposal a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:assurance ; skos:prefLabel "Change proposal"@en, "Proposta di cambiamento"@it ; skos:definition "Ipotesi di revisione prodotta dalle tracce, sottoposta a revisione, test e nuova versione."@it ; skos:relatedMatch tg:ChangeProposal .
tg:term-AccountableRole a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:assurance ; skos:prefLabel "Accountable role"@en, "Ruolo responsabile"@it ; skos:definition "Responsabilità assegnata e verificabile per curatela, decisione, esecuzione e contestazione."@it ; skos:relatedMatch tg:AccountableRole .
tg:term-ChallengeRecord a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:assurance ; skos:prefLabel "Challenge record"@en, "Contestazione"@it ; skos:definition "Obiezione motivata con evidenze, owner e stato; conserva la decisione originaria e l'eventuale rettifica."@it ; skos:relatedMatch tg:ChallengeRecord .
tg:term-ExecutionFence a skos:Concept ; skos:inScheme tg:Taxonomy ; skos:broader tg:procedure ; skos:prefLabel "Execution fence"@en, "Vincolo di esecuzione"@it ; skos:definition "Punto di controllo atomico lato adapter su versione risorsa, revoche, budget e idempotenza. Requisito progettuale."@it ; skos:relatedMatch tg:ExecutionFence .
