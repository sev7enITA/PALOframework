{
  "mcpServers": {
    "palo-knowledge-reader": {
      "httpUrl": "https://governance.paloframework.org/mcp-guide",
      "authProviderType": "dynamic_discovery",
      "oauth": {
        "enabled": true,
        "scopes": ["palo:guide", "palo:knowledge:read"],
        "audiences": ["https://governance.paloframework.org/mcp-guide"]
      },
      "includeTools": [
        "palo_explain_framework",
        "palo_infer_governance_route",
        "palo_plan_product_integration",
        "palo_list_knowledge_sources",
        "palo_search_knowledge",
        "palo_get_knowledge_record"
      ],
      "trust": false
    }
  }
}
