{
  "servers": {
    "palo-knowledge-curator": {
      "type": "http",
      "url": "https://governance.paloframework.org/mcp-guide-curator",
      "headers": {
        "Authorization": "Bearer ${input:palo-guide-curator-token}"
      }
    }
  },
  "inputs": [
