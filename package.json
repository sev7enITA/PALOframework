{
  "name": "palo-platform",
  "version": "3.1.0",
  "private": true,
  "description": "Deterministic validation, publication, and browser smoke tooling for the PALO static platform.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "semantic:bootstrap": "node scripts/generate-semantic-assets.mjs --bootstrap",
    "semantic:generate": "node scripts/generate-semantic-assets.mjs",
    "semantic:check": "node scripts/generate-semantic-assets.mjs --check",
    "semantic:validate": "node scripts/validate-semantic.mjs",
    "semantic:release": "node scripts/generate-semantic-release.mjs",
    "semantic:release:check": "node scripts/generate-semantic-release.mjs --check",
    "validate:text-style": "node scripts/validate-text-style.mjs --tracked",
    "evidence:validate": "node scripts/evidence-validate.mjs",
    "evidence:test": "node --test scripts/evidence-pack.test.mjs",
    "external-evidence:validate": "node scripts/validate-external-evidence.mjs",
    "external-evidence:test": "node --test packages/palo-external-evidence/*.test.js",
    "external-evidence:check": "npm run external-evidence:validate && npm run external-evidence:test",
    "external-evidence:sync": "node scripts/sync-external-agentic-evidence.mjs",
    "policywatcher-signal:validate": "node scripts/validate-policywatcher-signal.mjs",
    "policywatcher-signals:sync": "node scripts/sync-policywatcher-signals.mjs",
    "policywatcher-signals:check": "node scripts/check-policywatcher-signal-operations.mjs",
    "case:contribute": "node scripts/case-contribute.mjs",
    "activation:publish-issues": "node scripts/publish-activation-issues.mjs",
    "validate": "npm run validate:text-style && npm run external-evidence:check && npm run semantic:check && npm run semantic:validate && npm run semantic:release:check && node scripts/validate.mjs --root .",
    "validate:agentic": "node scripts/validate-agentic.mjs && node --test packages/palo-mcp-server/*.test.js && python3 -m unittest examples/agentic-interface/integrations/dify/test_palo_dify_tool.py",
    "opa:install": "node scripts/install-opa.mjs",
    "palo:mcp": "node packages/palo-mcp-server/index.js",
    "palo:mcp:http": "node packages/palo-mcp-server/http.js",
    "palo:gateway": "node packages/palo-mcp-server/gateway.js",
    "palo:evidence:verify": "node packages/palo-mcp-server/verify-evidence.js",
    "production:admission": "node scripts/validate-production-profile.mjs",
    "demo:hands-on": "node examples/hands-on-demo/run-assurance-cycle.mjs",
    "demo:microsoft-agt": "node examples/agentic-interface/integrations/microsoft-agt/run-demo.mjs",
    "demo:hands-on:legacy": "node examples/hands-on-demo/run-support-case.mjs",
    "demo:n8n:seed": "node examples/hands-on-demo/run-support-case.mjs --seed-n8n",
    "validate:dist": "node scripts/validate-text-style.mjs --root dist && node scripts/validate.mjs --root dist --built",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "package:hostinger": "node scripts/package-hostinger.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "p0:bootstrap": "npm ci --prefix governance-hub --ignore-scripts && npm run opa:install",
    "p0": "npm run p0:bootstrap && npm run validate:agentic && npm run validate && npm run build && npm run validate:dist && npm run build:check && npm run smoke"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "fast-xml-parser": "5.10.1",
    "html-validate": "11.5.5",
    "marked": "18.0.6",
    "playwright": "1.61.1",
    "sanitize-html": "2.17.6"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.11.1",
    "hono": "4.13.2",
    "jose": "6.2.8",
    "n3": "2.1.1",
    "zod": "4.4.3"
  }
}
