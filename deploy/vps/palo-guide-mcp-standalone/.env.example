PALO_DOMAIN=governance.paloframework.org
PALO_GUIDE_LOOPBACK_PORT=18879
PALO_GUIDE_IMAGE=palo-knowledge-reader:local
PALO_GUIDE_PUBLIC_URL=https://governance.paloframework.org/mcp-guide
PALO_OIDC_ISSUER=https://identity.example.org
PALO_OIDC_AUDIENCE=https://governance.paloframework.org/mcp-guide
PALO_OIDC_JWKS_URI=https://identity.example.org/.well-known/jwks.json
PALO_OIDC_ALGORITHMS=RS256 PS256 ES256 EdDSA
PALO_OIDC_ROLE_CLAIM=roles
PALO_OIDC_SCOPE_CLAIM=scope
PALO_OIDC_CLIENT_ID_CLAIM=azp
PALO_OIDC_TENANT_CLAIM=tid
PALO_OIDC_TOKEN_TYPE=at+jwt
# Optional: full scope identifiers clients must request when the IdP uses namespaced scopes.
PALO_OIDC_ADVERTISED_SCOPES=
PALO_OIDC_ALLOWED_CLIENT_IDS=replace-with-approved-oauth-client-id
PALO_OIDC_ALLOWED_TENANTS=replace-with-approved-tenant-id
PALO_READER_RATE_LIMIT_PER_MINUTE=120
PALO_READER_MAX_CONCURRENCY=32
PALO_READER_MAX_CONCURRENCY_PER_CLIENT=4
