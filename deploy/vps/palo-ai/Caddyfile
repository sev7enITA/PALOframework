{
	email {$ACME_EMAIL}
}

{$PALO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	log {
		output stdout
		format json
	}

	handle /mcp-health {
		rewrite * /health
		reverse_proxy palo-mcp:8788
	}

	handle /.well-known/oauth-protected-resource/mcp {
		reverse_proxy palo-mcp:8788
	}

	handle /mcp {
		reverse_proxy palo-mcp:8788
	}

	handle /mcp-guide-health {
		header Access-Control-Allow-Origin "https://sev7enita.github.io"
		header Vary "Origin"
		header Cache-Control "no-store"
		rewrite * /health
		reverse_proxy palo-guide-edge:8080 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	handle /.well-known/oauth-protected-resource/mcp-guide {
		header Access-Control-Allow-Origin "https://sev7enita.github.io"
		header Vary "Origin"
		header Cache-Control "no-store"
		reverse_proxy palo-guide-edge:8080 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	handle /mcp-guide {
		request_body {
			max_size 64KB
		}
		rewrite * /mcp
		reverse_proxy palo-guide-edge:8080 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	handle /mcp-guide/mcp {
		request_body {
			max_size 64KB
		}
		rewrite * /mcp
		reverse_proxy palo-guide-edge:8080 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	handle /mcp-guide-curator-health {
		header Access-Control-Allow-Origin "https://sev7enita.github.io"
		header Vary "Origin"
		header Cache-Control "no-store"
		rewrite * /health
		reverse_proxy palo-guide-curator-mcp:8790
	}

	handle /.well-known/oauth-protected-resource/mcp-guide-curator {
		header Access-Control-Allow-Origin "https://sev7enita.github.io"
		header Vary "Origin"
		header Cache-Control "no-store"
		reverse_proxy palo-guide-curator-mcp:8790
	}

	handle /mcp-guide-curator {
		rewrite * /mcp
		reverse_proxy palo-guide-curator-mcp:8790
	}

	handle /mcp-guide-curator/mcp {
		rewrite * /mcp
		reverse_proxy palo-guide-curator-mcp:8790
	}

	handle /identity-health {
		header Cache-Control "no-store"
		rewrite * /identity/health/ready
		reverse_proxy palo-identity:9000
	}

	handle /identity/admin/* {
		respond "Not found" 404
	}

	handle /identity/realms/master/* {
		respond "Not found" 404
	}

	handle /identity/realms/palo/.well-known/openid-configuration {
		header Access-Control-Allow-Origin "https://sev7enita.github.io"
		header Vary "Origin"
		header Cache-Control "no-store"
		reverse_proxy palo-identity:8080
	}

	handle /identity/realms/palo/* {
		reverse_proxy palo-identity:8080
	}

	handle /identity/resources/* {
		reverse_proxy palo-identity:8080
	}

	handle /identity/* {
		respond "Not found" 404
	}

	handle /hub {
		redir /hub/ 308
	}

	handle_path /hub/* {
		reverse_proxy palo-hub-ui:8080
	}

	handle_path /control-plane/* {
		reverse_proxy palo-hub-control-plane:8790
	}

	@blockedGateway {
		path /gateway/v1/agents/* /gateway/v1/policies/* /gateway/v1/executors/* /gateway/v1/verifiers/* /gateway/v1/approvals /gateway/v1/approvals/resolve /gateway/v1/tasks /gateway/v1/tasks/* /gateway/v1/operations/* /gateway/v1/incidents /gateway/v1/incidents/resolve /gateway/v1/evidence
	}
	handle @blockedGateway {
		respond "Not found" 404
	}

	@publicGateway {
		path /gateway/health /gateway/v1/registry /gateway/v1/actions/verify /gateway/v1/actions/execute /gateway/v1/executions/* /gateway/v1/approvals/* /gateway/v1/incidents/* /gateway/v1/evidence/verify-ledger
	}
	handle @publicGateway {
		uri strip_prefix /gateway
		reverse_proxy palo-gateway:8787
	}

	handle {
		respond "Not found" 404
	}
}
