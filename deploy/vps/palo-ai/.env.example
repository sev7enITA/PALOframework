PALO_DOMAIN=governance.example.org
ACME_EMAIL=security@example.org
PALO_ADMIN_URL=http://127.0.0.1:8787
# Reader and Curator trust only the PALO identity realm deployed by Compose.
PALO_OIDC_ALGORITHMS=RS256
PALO_OIDC_ROLE_CLAIM=roles
PALO_OIDC_SCOPE_CLAIM=scope
PALO_OIDC_CLIENT_ID_CLAIM=azp
PALO_OIDC_TENANT_CLAIM=tid
PALO_OIDC_TOKEN_TYPE=JWT
PALO_READER_OIDC_ALLOWED_CLIENT_IDS=palo-reader-smoke
PALO_CURATOR_OIDC_ALLOWED_CLIENT_IDS=palo-curator-smoke
PALO_OIDC_ALLOWED_TENANTS=palo
# Hostnames only; kept separate from the Host-header allowlist.
PALO_MCP_ALLOWED_ORIGINS=sev7enita.github.io
PALO_READER_RATE_LIMIT_PER_MINUTE=120
PALO_READER_MAX_CONCURRENCY=32
PALO_READER_MAX_CONCURRENCY_PER_CLIENT=4
OPA_IMAGE=openpolicyagent/opa:1.17.0-static
CADDY_IMAGE=caddy:2.11.4-alpine
# Opt-in Governance Hub control plane. These non-secret values are inert until
# the hub-control-plane Compose profile is enabled and the five hub secret files exist.
PALO_HUB_OIDC_ISSUER=https://identity.example.org
PALO_HUB_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.org/oauth2/authorize
PALO_HUB_OIDC_TOKEN_ENDPOINT=https://identity.example.org/oauth2/token
PALO_HUB_OIDC_JWKS_URI=https://identity.example.org/.well-known/jwks.json
PALO_HUB_OIDC_CLIENT_ID=palo-governance-hub
PALO_HUB_OIDC_AUDIENCE=palo-governance-hub
PALO_HUB_STEP_UP_ACR_VALUES=urn:example:loa:2
PALO_HUB_SIGNER_URL=https://signer.example.org/v1/sign
PALO_HUB_DATABASE_APPLICATION_ROLE=palo_hub_app
# The current preview gateway is not tenant-isolated and must not be declared
# upstream-enforced. Configure a separately assured tenant-aware adapter here.
PALO_HUB_ADAPTERS_JSON=[{"id":"tenant-adapter","platformId":"n8n-self-hosted","environment":"Isolated pilot","baseUrl":"https://adapter.example.org","healthPath":"/health","inventoryPath":"/v1/registry","tokenEnvironmentVariable":"PALO_HUB_ADAPTER_TOKEN","tenantIsolation":"upstream-enforced","tenantHeader":"x-palo-tenant-id"}]
NGINX_IMAGE=nginx:1.29.1-alpine
