PALO_COPILOT_IMAGE=palo-knowledge-copilot:local
PALO_COPILOT_LOOPBACK_PORT=18792
PALO_COPILOT_PUBLIC_URL=https://copilot-api.paloframework.org
PALO_COPILOT_ALLOWED_ORIGINS=https://paloframework.org

# Microsoft Entra tenant-specific endpoints. Replace TENANT_ID and WEB_APP_CLIENT_ID.
PALO_COPILOT_OIDC_ISSUER=https://login.microsoftonline.com/TENANT_ID/v2.0
PALO_COPILOT_OIDC_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/authorize
PALO_COPILOT_OIDC_TOKEN_ENDPOINT=https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/token
PALO_COPILOT_OIDC_JWKS_URI=https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys
PALO_COPILOT_OIDC_CLIENT_ID=WEB_APP_CLIENT_ID
PALO_COPILOT_OIDC_AUDIENCE=WEB_APP_CLIENT_ID
# Match the JOSE typ actually emitted by the tenant for ID tokens (Microsoft Entra normally emits JWT).
PALO_COPILOT_OIDC_ID_TOKEN_TYPE=JWT
PALO_COPILOT_OIDC_TENANT_CLAIM=tid
PALO_COPILOT_OIDC_GROUP_CLAIM=groups
PALO_COPILOT_OIDC_ALLOWED_TENANTS=TENANT_ID
# Optional but recommended for a company rollout.
PALO_COPILOT_OIDC_ALLOWED_GROUPS=

PALO_COPILOT_READER_URL=https://guide-api.paloframework.org/mcp-guide
PALO_COPILOT_READER_AUTH=client-credentials
PALO_COPILOT_READER_TOKEN_ENDPOINT=https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/token
PALO_COPILOT_READER_CLIENT_ID=READER_CLIENT_APP_ID
PALO_COPILOT_READER_SCOPE=api://READER_API_APP_ID/.default

PALO_COPILOT_MODEL_PROVIDER=openai
PALO_COPILOT_OPENAI_MODEL=REPLACE_WITH_APPROVED_MODEL
PALO_COPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
PALO_COPILOT_OPENAI_MAX_OUTPUT_TOKENS=900

PALO_COPILOT_SESSION_TTL_SECONDS=14400
PALO_COPILOT_REQUEST_MAXIMUM_BYTES=16384
PALO_COPILOT_QUESTION_MAXIMUM_CHARACTERS=4000
PALO_COPILOT_RATE_LIMIT_PER_MINUTE=30
PALO_COPILOT_READER_TIMEOUT_MS=15000
PALO_COPILOT_READER_RESPONSE_MAXIMUM_BYTES=1048576
PALO_COPILOT_MODEL_TIMEOUT_MS=30000
PALO_COPILOT_MAX_RETRIEVED_RECORDS=4
PALO_COPILOT_RUN_MIGRATIONS=false
